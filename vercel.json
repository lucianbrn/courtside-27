    { "source": "/nba-all-time-atlas/:path*", "destination": "/", "permanent": false },
    { "source": "/celtics-intro.mp4", "destination": "/", "permanent": false },
    { "source": "/heat-intro.mp4", "destination": "/", "permanent": false },
    { "source": "/warriors-intro.mp4", "destination": "/", "permanent": false },
    { "source": "/three.module.js", "destination": "/", "permanent": false }
  ]
}
